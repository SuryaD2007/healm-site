    "share-image": "node scripts/render-share-image.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "14.9.0",
    "oxc-transform-react": "0.156.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "6.0.3"
  },
  "overrides": {
