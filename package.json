{
  "name": "healm-site",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Healm's marketing site: the scan story, privacy, support and terms. Static Astro, served by GitHub Pages.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
