---
/**
 * Chapter 2, Ask. The app's Ask screen, rebuilt in HTML from the Footage agent's screenshots
 * (~/Developer/healm-content/stills/ask-conversation-*.png) so it can play: the question types itself
 * into the field, goes up as a bubble, "Reading your file" shows, the answer streams in as plain text the
 * way the app's does (Healm/Features/Ask/AskMessageViews.swift, AskStreamingView), then More, the
 * receipts and three follow-ups fade in together. The conversation is the real one from the screenshot.
 *
 * Every size inside the phone is in app points (--pt, PhoneFrame.astro), measured from the 440 pt screen.
 * The moving screen is hidden from assistive tech; the same conversation is in the page as plain text.
 * Behaviour: src/scripts/chapters/ask.ts.
 */
import PhoneFrame from '@/components/PhoneFrame.astro';

const question = 'Why do I feel so good today?';
const answer = 'You slept 8 hours, half an hour more than your usual, and your body noticed: resting heart rate 52 and HRV up.';
const because = ['slept 8h 0m vs your usual 7h 24m', 'resting HR 52 vs your usual 54', 'HRV 78 vs your usual 72'];
const followups = ['How do I get more mornings like this?', 'Should I go hard at the gym?', 'What’s my best bedtime?'];
---
<section id="ask" class="ask-chapter theme-light" aria-labelledby="ask-title" data-ask-chapter>
  <div class="wrap ask-grid">
    <div class="ask-copy">
      <h2 id="ask-title" class="ask-title">Ask it about your day.</h2>
      <p class="ask-lede">
        Healm answers from your health file and last night’s readings. Every answer shows the numbers behind it,
        and three good questions to ask next.
      </p>
      <button type="button" class="btn-text ask-replay" data-ask-replay hidden>Play it again</button>
      <!-- The conversation on the phone, for screen readers. -->
      <div class="sr-only">
        <p>An example from the app.</p>
        <p>You ask: {question}</p>
        <p>Healm answers: {answer} Because: {because.join('; ')}.</p>
        <p>Suggested next questions: {followups.join(' ')}</p>
      </div>
    </div>

    <PhoneFrame class="ask-phone">
      <div class="ask-screen theme-light" aria-hidden="true" data-ask-screen>
        <div class="as-status">
          <span class="as-time">9:41</span>
          <span class="as-island"></span>
          <span class="as-status-icons">
            <svg viewBox="0 0 18 12" class="as-signal"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
            <svg viewBox="0 0 16 12" class="as-wifi"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0zM3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0zM1 4.4a9.9 9.9 0 0 1 14 0l-1.4 1.4a7.9 7.9 0 0 0-11.2 0z" /></svg>
            <svg viewBox="0 0 27 13" class="as-battery"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke="currentColor" opacity="0.4" /><rect x="2" y="2" width="20" height="9" rx="2" /><path d="M25 4.5v4a2 2 0 0 0 0-4z" opacity="0.4" /></svg>
          </span>
        </div>

        <div class="as-header">
          <svg class="as-list" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 6h12M9 12h12M9 18h12" /><circle cx="4" cy="6" r="0.9" fill="currentColor" /><circle cx="4" cy="12" r="0.9" fill="currentColor" /><circle cx="4" cy="18" r="0.9" fill="currentColor" /></svg>
          <span class="as-title">Ask</span>
          <span class="as-clinician">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3H4v5a4 4 0 0 0 8 0V3h-1" /><path d="M8 12v2a5 5 0 0 0 10 0v-2" /><circle cx="18" cy="10" r="2" /></svg>
            Clinician
          </span>
        </div>

        <div class="as-thread">
          <div class="as-bubble" data-ask-bubble>{question}</div>
          <p class="as-waiting" data-ask-waiting>Reading your file</p>
          <p class="as-answer" data-ask-answer data-text={answer}>{answer}</p>
          <div class="as-details" data-ask-details>
            <span class="as-more">More</span>
            <p class="as-receipt">Because: {because.join(' · ')}</p>
            <div class="as-chips">
              {followups.map((f) => <span class="as-chip">{f}</span>)}
            </div>
          </div>
        </div>

        <div class="as-input">
          <span class="as-round">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M3 8.5a2 2 0 0 1 2-2h2.4L9 4.5h6l1.6 2H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><circle cx="12" cy="13" r="3.6" /></svg>
          </span>
          <span class="as-field">
            <span class="as-placeholder" data-ask-placeholder>Ask anything</span>
            <span class="as-typed" data-ask-typed></span><span class="as-caret" data-ask-caret></span>
          </span>
          <span class="as-round as-send" data-ask-send>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
          </span>
        </div>

        <div class="as-tabs">
          <span class="as-tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>Today</span>
          <span class="as-tab is-selected"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M3.5 6.5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-3.5 3v-3a2 2 0 0 1-2-2z" /><path d="M10 15.5a2 2 0 0 0 2 2h4.5l3 2.5v-2.5a2 2 0 0 0 1.5-2v-5a2 2 0 0 0-2-2" /><path d="M7 8h7M7 10.5h5" stroke-linecap="round" /></svg>Ask</span>
          <span class="as-tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16" /><rect x="7.5" y="8.5" width="9" height="7" rx="1.5" /><circle cx="12" cy="12" r="1.8" /></svg>Scan</span>
          <span class="as-tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M5 8h14l-1 12H6z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" /></svg>Order</span>
          <span class="as-tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="8.5" cy="10.5" r="2" /><path d="M5.5 16a3 3 0 0 1 6 0M14 9.5h4.5M14 12.5h4.5M14 15.5h3" /></svg>You</span>
        </div>
      </div>
    </PhoneFrame>
  </div>
</section>

<style is:global>
  .ask-chapter { padding-block: var(--space-5xl); }
  .ask-grid { display: grid; gap: var(--space-3xl); align-items: center; justify-items: center; }
  .ask-copy { max-width: 30rem; justify-self: start; }
  .ask-title { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: var(--type-section); line-height: var(--type-section-leading); letter-spacing: var(--tracking-display); }
  .ask-lede { margin: var(--space-md) 0 0; color: var(--ink2); font-size: var(--type-lede); }
  .ask-replay { margin-top: var(--space-lg); }
  .ask-replay[hidden] { display: none; }
  .ask-phone { --phone-w: min(78vw, 340px); }
  @media (min-width: 900px) {
    .ask-grid { grid-template-columns: 1fr auto; column-gap: var(--space-5xl); }
    .ask-phone { --phone-w: min(30vw, 360px, calc(78svh / 2.1)); }
  }

  /* The Ask screen, in app points. */
  .ask-screen {
    position: absolute;
    inset: 0;
    font-family: var(--font-sans);
    color: var(--ink);
    background: var(--ground);
    font-size: calc(17 * var(--pt));
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }
  .ask-screen svg { display: block; }
  .as-status { position: absolute; inset: 0 0 auto 0; height: calc(54 * var(--pt)); }
  .as-time { position: absolute; left: calc(60 * var(--pt)); top: calc(20 * var(--pt)); font-size: calc(17 * var(--pt)); font-weight: 600; letter-spacing: -0.01em; }
  .as-island { position: absolute; left: calc(158 * var(--pt)); top: calc(14 * var(--pt)); width: calc(125 * var(--pt)); height: calc(37 * var(--pt)); border-radius: 999px; background: #000; }
  .as-status-icons { position: absolute; right: calc(28 * var(--pt)); top: calc(24 * var(--pt)); display: flex; gap: calc(6 * var(--pt)); align-items: center; color: #000; }
  .as-signal { width: calc(18 * var(--pt)); fill: currentColor; opacity: 0.35; }
  .as-wifi { width: calc(16 * var(--pt)); fill: currentColor; }
  .as-battery { width: calc(27 * var(--pt)); fill: currentColor; }

  .as-header { position: absolute; left: calc(24 * var(--pt)); right: calc(24 * var(--pt)); top: calc(66 * var(--pt)); height: calc(39 * var(--pt)); display: flex; align-items: center; }
  .as-list { width: calc(22 * var(--pt)); color: var(--ink); }
  .as-title { margin-left: calc(22 * var(--pt)); font-family: var(--font-serif); font-size: calc(30 * var(--pt)); line-height: 1; }
  .as-clinician { margin-left: auto; display: inline-flex; align-items: center; gap: calc(8 * var(--pt)); height: 100%; padding: 0 calc(16 * var(--pt)); border: 1px solid var(--control-border); border-radius: 999px; font-size: calc(16 * var(--pt)); }
  .as-clinician svg { width: calc(20 * var(--pt)); }

  .as-thread { position: absolute; left: calc(24 * var(--pt)); right: calc(24 * var(--pt)); top: calc(124 * var(--pt)); }
  .as-bubble { margin-left: auto; width: max-content; max-width: calc(330 * var(--pt)); padding: calc(10 * var(--pt)) calc(16 * var(--pt)); border-radius: calc(14 * var(--pt)); background: var(--surface); }
  .as-waiting { margin: calc(24 * var(--pt)) 0 0; color: var(--ink2); font-size: calc(15 * var(--pt)); }
  .as-answer { margin: calc(24 * var(--pt)) 0 0; line-height: calc(24.4 / 17); min-height: calc(73 * var(--pt)); }
  .as-details { margin-top: calc(24 * var(--pt)); }
  .as-more { display: block; color: var(--action); font-size: calc(16 * var(--pt)); font-weight: 500; }
  .as-receipt { margin: calc(26 * var(--pt)) 0 0; color: var(--ink2); font-size: calc(13 * var(--pt)); line-height: calc(18 / 13); }
  .as-chips { margin-top: calc(18 * var(--pt)); display: grid; justify-items: start; gap: calc(9 * var(--pt)); }
  .as-chip { display: inline-flex; align-items: center; height: calc(38 * var(--pt)); padding: 0 calc(16 * var(--pt)); border: 1px solid var(--control-border); border-radius: 999px; font-size: calc(15 * var(--pt)); }

  .as-input { position: absolute; left: 0; right: 0; top: calc(809 * var(--pt)); padding: calc(10 * var(--pt)) calc(20 * var(--pt)) 0; border-top: 1px solid var(--hairline); display: flex; gap: calc(8 * var(--pt)); align-items: center; }
  .as-round { flex: none; display: grid; place-items: center; width: calc(46 * var(--pt)); height: calc(46 * var(--pt)); border-radius: 50%; border: 1px solid var(--control-border); color: var(--ink); }
  .as-round svg { width: calc(22 * var(--pt)); }
  .as-send { border-color: var(--hairline); color: var(--ink2); transition: background-color var(--dur-fade) var(--ease-reveal), color var(--dur-fade) var(--ease-reveal); }
  .as-send.is-ready { background: var(--ink); border-color: var(--ink); color: var(--ground); }
  .as-field { flex: 1; min-width: 0; height: calc(47 * var(--pt)); display: flex; align-items: center; padding: 0 calc(16 * var(--pt)); border: 1px solid var(--control-border); border-radius: 999px; white-space: nowrap; overflow: hidden; }
  .as-placeholder { color: var(--ink2); }
  .as-caret { display: none; width: 1.5px; height: 1.1em; margin-left: 1px; background: var(--action); }

  .as-tabs { position: absolute; left: calc(21 * var(--pt)); right: calc(21 * var(--pt)); top: calc(873 * var(--pt)); height: calc(61 * var(--pt)); border-radius: 999px; background: color-mix(in srgb, var(--surface) 55%, var(--ground)); display: grid; grid-template-columns: repeat(5, 1fr); align-items: center; padding: 0 calc(4 * var(--pt)); }
  .as-tab { display: grid; justify-items: center; gap: calc(2 * var(--pt)); font-size: calc(11 * var(--pt)); font-weight: 600; color: var(--ink); height: calc(53 * var(--pt)); align-content: center; border-radius: 999px; }
  .as-tab svg { width: calc(26 * var(--pt)); }
  .as-tab.is-selected { background: var(--hairline); }

  /* While the demo plays: what has not happened yet is hidden, without moving anything else. */
  .ask-screen.is-playing [data-ask-bubble],
  .ask-screen.is-playing [data-ask-waiting],
  .ask-screen.is-playing [data-ask-details] { opacity: 0; }
  .ask-screen [data-ask-waiting] { display: none; }
  .ask-screen.is-waiting [data-ask-waiting] { display: block; opacity: 1; }
  .ask-screen.is-waiting [data-ask-answer] { display: none; }
  .ask-screen.is-typing .as-placeholder { display: none; }
  .ask-screen.is-typing .as-caret { display: inline-block; }
  .ask-screen [data-ask-bubble],
  .ask-screen [data-ask-details] { transition: opacity var(--dur-fade) var(--ease-reveal), transform var(--dur-result) var(--ease-reveal); }
  .ask-screen.is-sent [data-ask-bubble] { opacity: 1; }
  .ask-screen.is-playing:not(.is-sent) [data-ask-bubble] { transform: translateY(calc(8 * var(--pt))); }
  .ask-screen.is-done [data-ask-details] { opacity: 1; }
</style>

<script>
  import '@/scripts/chapters/ask';
</script>
