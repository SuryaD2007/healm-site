---
/**
 * Chapter 3, Live steps. The app's Live Activity on a lock screen, rebuilt from the Footage agent's still
 * (stills/lock-screen-dark.png) in app points, so it can count: while the chapter is on screen, today's
 * steps and the walk's go up at a walking pace, the digits roll, and the footstep dot pulses once with
 * each new count, as in HealmActivity/StepGoalLiveActivity.swift (FootstepDot: a 6 pt dot that grows in
 * from 1.8x as the last one fades). The wallpaper is plain, not Apple's. A pause stops the count (it
 * runs for as long as the chapter is on screen: WCAG 2.2.2). Under Reduce Motion the numbers stand still.
 * Behaviour: src/scripts/chapters/steps.ts.
 */
import PhoneFrame from '@/components/PhoneFrame.astro';
import PauseButton from '@/components/PauseButton.astro';
---
<section id="steps" class="chapter theme-dark" aria-labelledby="steps-title" data-steps-chapter>
  <div class="wrap chapter-grid">
    <div class="chapter-copy">
      <h2 id="steps-title" class="chapter-title">Your steps, live on your lock screen.</h2>
      <p class="chapter-lede">
        Start a walk and the count goes up with every step, right on your lock screen. It stops by itself after
        five minutes without one.
      </p>
    </div>

    <div class="chapter-device">
      <PhoneFrame class="chapter-phone" label="Healm’s Live Activity on a lock screen: 8,455 steps of 10,000, a walk of 21 steps, and a Stop button.">
        <div class="lock" aria-hidden="true" data-lock>
          <span class="lock-island"></span>
          <span class="lock-icons">
            <svg viewBox="0 0 16 12"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0zM3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0zM1 4.4a9.9 9.9 0 0 1 14 0l-1.4 1.4a7.9 7.9 0 0 0-11.2 0z" /></svg>
            <svg viewBox="0 0 27 13"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke="currentColor" opacity="0.4" /><rect x="2" y="2" width="20" height="9" rx="2" /><path d="M25 4.5v4a2 2 0 0 0 0-4z" opacity="0.4" /></svg>
          </span>
          <p class="lock-date" data-lock-date>Thu Nov 19</p>
          <p class="lock-time">9:41</p>

          <div class="la">
            <div class="la-top">
              <span class="la-count tabular" data-la-count>8,455</span>
              <span class="la-dot" data-la-dot></span>
              <span class="la-unit">steps</span>
              <span class="la-goal tabular">of 10,000</span>
            </div>
            <div class="la-bar"><span class="la-fill" data-la-fill></span></div>
            <div class="la-row">
              <div>
                <p class="la-walk tabular">Walk <span data-la-walk>21</span> steps · <span data-la-miles>0.0</span> mi</p>
                <p class="la-time tabular" data-la-time>0:33</p>
              </div>
              <span class="la-stop">
                <svg viewBox="0 0 12 12"><rect x="1" y="1" width="10" height="10" rx="2" /></svg>
                Stop
              </span>
            </div>
          </div>
          <span class="lock-home"></span>
        </div>
      </PhoneFrame>
      <PauseButton label="Pause the step count" />
    </div>
  </div>
</section>

<style is:global>
  .lock {
    position: absolute;
    inset: 0;
    background: var(--camera-backdrop);
    color: var(--ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  .lock svg { display: block; fill: currentColor; }
  .lock-island { position: absolute; left: calc(158 * var(--pt)); top: calc(14 * var(--pt)); width: calc(125 * var(--pt)); height: calc(37 * var(--pt)); border-radius: 999px; background: #000; }
  .lock-icons { position: absolute; right: calc(28 * var(--pt)); top: calc(24 * var(--pt)); display: flex; gap: calc(6 * var(--pt)); color: var(--ink); }
  .lock-icons svg:first-child { width: calc(16 * var(--pt)); }
  .lock-icons svg:last-child { width: calc(27 * var(--pt)); }
  .lock-date { position: absolute; left: 0; right: 0; top: calc(92 * var(--pt)); margin: 0; text-align: center; font-size: calc(21 * var(--pt)); font-weight: 600; color: color-mix(in srgb, var(--ink) 80%, transparent); }
  .lock-time { position: absolute; left: 0; right: 0; top: calc(112 * var(--pt)); margin: 0; text-align: center; font-size: calc(104 * var(--pt)); line-height: 1; font-weight: 600; letter-spacing: -0.02em; color: color-mix(in srgb, var(--ink) 88%, transparent); }
  .lock-home { position: absolute; left: 50%; bottom: calc(8 * var(--pt)); width: calc(140 * var(--pt)); height: calc(5 * var(--pt)); margin-left: calc(-70 * var(--pt)); border-radius: 999px; background: var(--ink); opacity: 0.8; }

  /* The Live Activity: HealmColor.ground behind it, as the activity's background tint. */
  .la {
    position: absolute;
    left: calc(16 * var(--pt));
    right: calc(16 * var(--pt));
    top: calc(560 * var(--pt));
    padding: calc(18 * var(--pt)) calc(18 * var(--pt)) calc(16 * var(--pt));
    border-radius: calc(24 * var(--pt));
    background: var(--ground);
    border: 1px solid var(--hairline);
  }
  .la-top { display: flex; align-items: baseline; gap: calc(8 * var(--pt)); }
  .la-count { font-family: var(--font-serif); font-size: calc(34 * var(--pt)); line-height: 1; display: inline-flex; }
  .la-count > span { display: inline-block; }
  .la-count > span.is-rolling { animation: la-roll 260ms var(--ease-reveal); }
  @keyframes la-roll { from { transform: translateY(0.45em); opacity: 0; } }
  .la-dot { width: calc(6 * var(--pt)); height: calc(6 * var(--pt)); border-radius: 50%; background: var(--ink); align-self: center; }
  .la-dot.is-pulsing { animation: la-pulse 300ms var(--ease-reveal); }
  @keyframes la-pulse { from { transform: scale(1.8); opacity: 0; } }
  .la-unit { color: var(--ink2); font-size: calc(16 * var(--pt)); }
  .la-goal { margin-left: auto; color: var(--ink2); font-size: calc(16 * var(--pt)); }
  .la-bar { position: relative; margin-top: calc(14 * var(--pt)); height: calc(3 * var(--pt)); border-radius: 999px; background: var(--hairline); overflow: hidden; }
  .la-fill { position: absolute; inset: 0; transform-origin: left; transform: scaleX(0.8455); background: var(--ink); border-radius: inherit; transition: transform 300ms var(--ease-reveal); }
  .la-row { margin-top: calc(14 * var(--pt)); display: flex; align-items: center; justify-content: space-between; }
  .la-walk { margin: 0; font-size: calc(15 * var(--pt)); }
  .la-time { margin: calc(2 * var(--pt)) 0 0; color: var(--ink2); font-size: calc(12 * var(--pt)); }
  .la-stop { display: inline-flex; align-items: center; gap: calc(8 * var(--pt)); height: calc(40 * var(--pt)); padding: 0 calc(16 * var(--pt)); border: 1px solid var(--control-border); border-radius: 999px; font-size: calc(15 * var(--pt)); font-weight: 500; }
  .la-stop svg { width: calc(11 * var(--pt)); }
</style>

<script>
  import '@/scripts/chapters/steps';
</script>
