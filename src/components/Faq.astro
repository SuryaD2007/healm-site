---
/**
 * The home page's questions. Every answer is said already in terms.html, privacy.html or the support page;
 * change them together. Native <details>: keyboard and VoiceOver work without a script. FAQPage structured
 * data goes in the head (src/pages/index.astro) from the same list.
 */
import { faqs } from '@/lib/faqs';
---
<section id="faq" class="faq theme-light" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <h2 id="faq-title" class="chapter-title faq-title">Questions</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary class="faq-q">
            <span>{f.q}</span>
            <svg class="faq-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .faq { padding-block: var(--space-5xl); }
  .faq-grid { display: grid; gap: var(--space-2xl); }
  .faq-list { border-top: 1px solid var(--hairline); }
  .faq-item { border-bottom: 1px solid var(--hairline); }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--size-tap);
    padding: var(--space-md) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: var(--type-card-title);
    line-height: 1.25;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-icon { flex: none; color: var(--ink2); transition: transform var(--dur-move) var(--ease-move); }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  .faq-a { padding: 0 0 var(--space-lg); }
  .faq-a p { margin: 0; max-width: 40rem; color: var(--ink2); }
  @media (min-width: 900px) {
    .faq-grid { grid-template-columns: 1fr 2fr; column-gap: var(--space-4xl); align-items: start; }
  }
</style>
