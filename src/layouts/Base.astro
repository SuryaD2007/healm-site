---
import '@/styles/global.css';
import { url } from '@/lib/url';
import { site } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  /** "dark" for the scan story, "auto" for privacy, support and terms. */
  theme?: 'dark' | 'light' | 'auto';
  noindex?: boolean;
}

const { title, description, theme = 'dark', noindex = false } = Astro.props;
const themeColor = theme === 'light' ? '#FFFFFF' : '#0D1F22';

// Absolute URLs for sharing: this page, and the share image (scripts/render-share-image.mjs).
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site).href;
const shareImage = new URL(url('share/healm.png'), Astro.site).href;

// Instrument Serif, the app's display face (Healm/Resources/Fonts; SIL Open Font License, public/fonts/OFL.txt),
// subset to Latin and punctuation as WOFF2.
const fontFaces = `
@font-face{font-family:"Instrument Serif";src:url("${url('fonts/InstrumentSerif-Regular.woff2')}") format("woff2");font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:"Instrument Serif";src:url("${url('fonts/InstrumentSerif-Italic.woff2')}") format("woff2");font-weight:400;font-style:italic;font-display:swap}`;
---
<!doctype html>
<html lang="en" class={`theme-${theme}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

    <!-- Sharing: Open Graph and X. The image is 1200 x 630. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Healm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A head drawn in scan lines inside Healm’s scan ring, beside the words Turn your head. Healm reads the rest." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.socials.find((s) => s.name === 'X')?.handle} />

    <!-- Safari's Smart App Banner, once Healm has an App Store ID (src/lib/site.ts). -->
    {site.appStoreId && <meta name="apple-itunes-app" content={`app-id=${site.appStoreId}`} />}
    {theme === 'auto' ? (
      <>
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0D1F22" />
      </>
    ) : (
      <meta name="theme-color" content={themeColor} />
    )}
    <link rel="icon" href={url('brand/icon-dark.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="preload" href={url('fonts/InstrumentSerif-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <!-- Decided before first paint, so the Scan chapter never jumps from its plain layout to the pinned
         one (src/components/chapters/ScanChapter.astro takes it off again if the sequence can't run). -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !/[?&]poster=/.test(location.search)) {
        document.documentElement.classList.add('seq-on');
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import { startCursor } from '@/scripts/cursor';
      import { bindSoundToggles } from '@/scripts/sound';
      startCursor();
      bindSoundToggles();
    </script>
  </body>
</html>
